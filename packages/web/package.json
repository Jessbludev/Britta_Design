  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "repository": { "type": "git", "url": "https://github.com/Jessbludev/Britta_Design.git" },
  "sideEffects": ["*.css"],
  "engines": { "node": ">=20" }
}
