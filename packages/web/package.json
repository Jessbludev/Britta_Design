{
  "name": "@jessbludev/britta-design-web",
  "version": "0.3.0",
  "description": "Britta Design icons, themes, tokens and font assets for Web/React",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
